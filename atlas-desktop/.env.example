# Atlas Desktop — secrets & credentials. Copy to `.env` and fill in. NEVER commit `.env`.

# --- Anthropic (the brain / Claude Agent SDK) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Cloud (Chirp STT + TTS) ---
# Path to your Google Cloud service-account JSON key with Speech-to-Text + Text-to-Speech enabled.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/gcp-service-account.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# --- Picovoice (wake word "Hey Atlas") ---
# Free access key from https://console.picovoice.ai
PICOVOICE_ACCESS_KEY=...
